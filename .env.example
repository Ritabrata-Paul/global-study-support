# Public metadata/contact. This email was supplied by the business owner.
NEXT_PUBLIC_SITE_URL=https://global-study-support.patelprincem2000.chatgpt.site
NEXT_PUBLIC_CONTACT_EMAIL=support@globalstudysupport.com

# Server-only: set these through your hosting secret settings; never use NEXT_PUBLIC_.
# Exact origin, with no trailing slash. For local testing use http://localhost:3000.
ENQUIRY_ALLOWED_ORIGIN=
ENQUIRY_TO_EMAIL=
# Plain verified sender email, without a display name.
ENQUIRY_FROM_EMAIL=
RESEND_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional attachment screening. Uploads stay disabled until both are configured.
# HTTPS POST raw bytes, Bearer token, JSON response {"clean":true} only for clean files.
ATTACHMENT_SCAN_URL=
ATTACHMENT_SCAN_API_KEY=

# Set true ONLY behind a trusted proxy that overwrites client IP headers.
# Otherwise the local rate limiter uses one shared bucket for all requests.
ENQUIRY_TRUST_PROXY=false
